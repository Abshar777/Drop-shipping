# Copy to .env.local for local overrides. None of these are needed on your own machine:
# locally the store reads and writes the JSON files under data/.

# Hosted data store, required on Vercel (its disk is read-only).
# Vercel dashboard -> Storage -> Create -> Upstash (Redis). Vercel adds these two automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Image uploads on Vercel. Vercel dashboard -> Storage -> Create -> Blob. Vercel adds this automatically.
BLOB_READ_WRITE_TOKEN=

# First admin on a fresh deployment. Set these in Vercel, redeploy, sign in once, then you may remove them.
# The account is created only if no admin with this email exists. Password must be at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin
